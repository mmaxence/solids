{
  "name": "solids",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight 3D objects for the web. Zero dependencies.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-types.mjs",
    "check": "node scripts/build.mjs && node scripts/gen-site.mjs && node scripts/check.mjs",
    "site": "node scripts/gen-site.mjs",
    "covers": "node scripts/covers.mjs",
    "dev": "node scripts/dev.mjs",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "main": "./dist/solids.js",
  "module": "./dist/solids.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/solids.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./dist/solids.js": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/solids.js"
    },
    "./dist/core.js": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/types/**/*.d.ts",
    "README.md",
    "LICENSE",
    "docs/SKILL.md"
  ]
}
